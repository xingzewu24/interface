<mujoco model="g1_29dof">
  <!--
    Metatron G1 仿真模型，由 g1_holo_compat.xml 打补丁得到。
    position 执行器做隐式 PD，ctrl 是关节目标角。
    策略 50 Hz。循环里把 timestep 设为 0.001，每拍 mj_step 20 次。
  -->

  <compiler angle="radian" meshdir="meshes"/>

  <!-- 步长不写进这里，由循环按契约设置 -->
  <!-- <option timestep="0.001"/> -->

  <!-- 重复参数收进默认类，关节和几何只写各自不同的部分 -->
  <default>
    <default class="g1">
      <!-- 受控关节：限幅、摩擦、限位阻抗。刚度阻尼为 0，PD 在 position 上 -->
      <joint limited="true" stiffness="0" damping="0" frictionloss="0.1" solimplimit="0.97 0.995 0.001"/>
      <position ctrllimited="false" forcelimited="true"/>
    </default>
    <!-- 网格外观，不参与碰撞 -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
    </default>
    <!-- 碰撞体放在 group 5，默认视图里隐藏 -->
    <default class="collision">
      <geom contype="1" conaffinity="1" group="5" rgba=".2 .6 .2 .3"/>
    </default>
    <!-- 肩部装饰圆柱，无碰撞 -->
    <default class="decoration">
      <geom contype="0" conaffinity="0" group="5" density="0" material="silver"/>
    </default>
    <!-- head / rubber_hand 运动学标记，无质量 -->
    <default class="marker">
      <geom type="sphere" size=".0001" contype="0" conaffinity="0" group="5" density="0"/>
    </default>
    <default class="marker_site">
      <site group="5" rgba="1 0 0 1"/>
    </default>
    <default class="foot_floor">
      <pair solref="0.01 1" friction="0.8 0.8"/>
    </default>
    <!-- 脚踝耦合腱。默认类写在 tendon 上，fixed 用 class 引用 -->
    <default class="ankle">
      <tendon limited="true" solreflimit="0.003 1" solimplimit="0.99 0.999 0.0005 0 2"/>
    </default>
  </default>

